{
  "version": 2,
  "builds": [
    {
      "src": "api/predict.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python"
    },
    {
      "src": "ML/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/predict", "dest": "api/predict.py" },
    { "src": "/api/health",  "dest": "api/health.py"  },
    { "src": "/predict",     "dest": "api/predict.py" },
    { "src": "/health",      "dest": "api/health.py"  },
    { "src": "/(.*)",        "dest": "ML/frontend/$1" }
  ]
}
